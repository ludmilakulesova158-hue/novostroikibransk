# Шаблон .env для сайта novostroikibransk (ядро egorov_seo). Скопировать в .env, заполнить.
# .env в .gitignore — секреты не коммитим. Имена переменных читает scripts/seo-agent/config.mjs.

# --- Сайт ---
SITE_URL=https://novostroikibransk.ru

# --- xmlstock (SERP/семантика) — общий ключ ---
XMLSTOCK_USER=
XMLSTOCK_KEY=
XMLSTOCK_LR=225

# --- LLM-провайдеры (OpenAI-совместимые). Заполнить хотя бы основной (closerouter). ---
CLOSEROUTER_BASE_URL=https://api.closerouter.dev/v1
CLOSEROUTER_API_KEY=
CLOSEROUTER_MODEL=anthropic/claude-sonnet-4.6
CLOSEROUTER_DIALOG_MODEL=openai/gpt-5.4-mini
ANYMODEL_BASE_URL=https://anymodel.org/v1
ANYMODEL_API_KEY=
ANYMODEL_MODEL=cc/claude-sonnet-4-6
ANYMODEL_DIALOG_MODEL=cx/gpt-5.4-mini
WELLFLOW_BASE_URL=https://api.wellflow.dev/v1
WELLFLOW_API_KEY=
WELLFLOW_MODEL=qwen3.7-max
WELLFLOW_DIALOG_MODEL=qwen3.5-flash

# --- Уникальность: content-watch (основной) → text.ru (резерв) ---
CONTENTWATCH_KEY=
TEXTRU_KEY=
TEXTRU_MIN_UNIQUE=82

# --- Arsenkin (LSI/Wordstat/PAA) — общий ключ ---
ARSENKIN_API_KEY=
ARSENKIN_REGION=225

# --- Яндекс.Вебмастер + Метрика — СВОИ у каждого сайта ---
YANDEX_WEBMASTER_TOKEN=
YANDEX_WEBMASTER_USER_ID=
YANDEX_WEBMASTER_HOST_ID=https:novostroikibransk.ru:443
YANDEX_METRIKA_TOKEN=
YANDEX_METRIKA_COUNTER=

# --- IndexNow ---
INDEXNOW_KEY=

# --- Telegram (бот заявок/отчётов) — СВОЙ у каждого сайта ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
LEAD_PORT=8787

# --- MAX (доп. канал заявок) — общий бот-токен ---
MAX_BOT_TOKEN=

# --- kie.ai (картинки Nano Banana 2, резерв; Pollinations бесплатный) ---
KIE_API_KEY=
KIE_BASE_URL=https://api.kie.ai

# --- FTP-хостинг сайта (Reg.ru) ---
FTP_HOST=
FTP_USER=
FTP_PASS=
FTP_REMOTE_DIR=/www/novostroikibransk.ru

# --- Публичные переменные фронта (Astro PUBLIC_*) ---
PUBLIC_METRIKA_ID=
PUBLIC_LEAD_ENDPOINT=/api/lead.php

# --- Агент ---
MAX_NEW_PAGES=3
DRY_RUN=true
BATCH_COUNT=150
CONFIDENCE_MIN=0.78

# --- Google PageSpeed Insights (Core Web Vitals, опционально) ---
PAGESPEED_KEY=
