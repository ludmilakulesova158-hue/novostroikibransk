---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Features from '../../components/blocks/Features.astro';
import Steps from '../../components/blocks/Steps.astro';
import Faqs from '../../components/blocks/Faqs.astro';
import CallToAction from '../../components/blocks/CallToAction.astro';
import LeadForm from '../../components/LeadForm.astro';

const features = [
  { icon: 'home', title: 'Дома и коттеджи', text: 'Подберу дом в Брянском районе и области под бюджет и запрос семьи.' },
  { icon: 'map-pin', title: 'Участки', text: 'Проверю категорию земли, границы, коммуникации и обременения.' },
  { icon: 'shield', title: 'Проверка объекта', text: 'Документы, обременения, коммуникации, состояние дома и земли.' },
  { icon: 'key', title: 'Сделка под ключ', text: 'Договор, расчёты, регистрация — полное сопровождение.' },
];

const steps = [
  { title: 'Запрос и бюджет', text: 'Уточняем направление, расстояние от города, площадь и бюджет.' },
  { title: 'Подбор', text: 'Отбираю дома и участки, отсеиваю проблемные объекты и «кота в мешке».' },
  { title: 'Выезд и проверка', text: 'Смотрим объект, проверяю документы, землю и коммуникации.' },
  { title: 'Сделка', text: 'Сопровождаю сделку до регистрации и передачи объекта.' },
];

const faq = [
  { q: 'Где смотреть загородные дома под Брянском?', a: 'Популярны Брянский район и ближайшие направления — там сочетаются цена, дороги и природа. Конкретное направление подбираем под ваш маршрут на работу и образ жизни.' },
  { q: 'На что смотреть при покупке участка?', a: 'Категория земли и разрешённое использование, границы и кадастровые работы, наличие коммуникаций и подъездных путей, обременения. Всё проверяется по документам и на местности.' },
  { q: 'Можно ли купить дом в ипотеку?', a: 'Да, по программам на готовое и строящееся жильё. Требования банков к объекту и участку отличаются — помогу подобрать подходящий вариант.' },
  { q: 'Вы выезжаете на осмотр?', a: 'Да, осмотр объекта и проверка на месте — обязательная часть работы с загородной недвижимостью.' },
  { q: 'Насколько далеко от Брянска вы работаете?', a: 'Работаю по Брянскому району и области. Чем дальше объект, тем важнее заранее оценить дорогу, инфраструктуру и перспективы — это часть консультации.' },
];
---
<BaseLayout
  title="Загородная недвижимость под Брянском — дома и участки"
  description="Купить дом, коттедж или участок под Брянском: подбор, проверка земли и документов, сопровождение сделки. Помощь эксперта по недвижимости Ольги Валентиновой."
  path="/zagorod/"
>
  <Breadcrumbs items={[{ name: 'Загородная недвижимость', href: '/zagorod/' }]} />

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Загородная недвижимость</p>
      <h1>Дома и участки под Брянском</h1>
      <p class="lead">Загородная жизнь в 5–20 минутах от города: дома, коттеджи, таунхаусы и участки в Брянском районе и области. Подберу объект, проверю землю и документы, проведу сделку.</p>
      <div class="page-hero__actions">
        <a class="btn btn--primary" href="#zayavka">Подобрать дом или участок</a>
        <a class="btn btn--ghost" href="#process">Как это работает</a>
      </div>
    </div>
  </section>

  <Features eyebrow="Что я сделаю" title="Загородка — с проверкой земли" items={features} columns={4} />

  <section class="section section--paper2" id="process">
    <div class="container">
      <Steps eyebrow="Процесс" title="Как проходит покупка за городом" items={steps} />
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow prose">
      <h2>Загородная недвижимость: что важно знать</h2>
      <p>За городом цена ошибки выше, чем в квартире: документы на землю, категория и разрешённое использование, реальные границы участка, коммуникации и подъездные пути. Всё это нужно проверять до сделки — по документам и на месте.</p>
      <p>Форматы разные: участок под строительство, готовый дом, коттедж в охраняемом поселке или таунхаус вроде клубных домов «ГРИНВУД» рядом с рощей «Соловьи». Мы подбираем формат под ваш бюджет, маршрут на работу и планы на будущее.</p>
    </div>
  </section>

  <section class="section section--paper2">
    <div class="container container--narrow prose">
      <h2>Форматы загородной недвижимости</h2>
      <p>Загородка — это не только «дом в деревне». Форматов много, и у каждого свои плюсы. Участок под строительство даёт свободу, но требует времени и вложений. Готовый дом позволяет заехать сразу, но важно проверить его состояние и документы. Коттедж в охраняемом поселке — это инфраструктура и безопасность. Таунхаус или клубный дом вроде «ГРИНВУД» рядом с рощей «Соловьи» — компромисс между городом и природой.</p>
      <p>Мы подбираем формат под ваш бюджет, маршрут на работу и планы: растить детей, принимать гостей, заниматься хозяйством или просто отдыхать. Важно заранее понять, какой образ жизни вы хотите, — от этого зависит и выбор направления, и цена.</p>
    </div>
  </section>

  <Faqs items={faq} eyebrow="Вопросы" title="Частые вопросы о загородной недвижимости" />
  <LeadForm title="Подберу дом или участок под Брянском" source="zagorod" />
  <CallToAction title="Хотите продать дом или участок?" text="Оценю объект, подготовлю к продаже и найду покупателя." secondary={{ text: 'Продать недвижимость', href: '/uslugi/prodam-nedvizhimost/' }} />

  <style>
    .page-hero { padding: clamp(24px, 4vw, 48px) 0 clamp(20px, 3vw, 36px); }
    .page-hero h1 { margin-bottom: 16px; }
    .page-hero .lead { max-width: 68ch; }
    .page-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  </style>
</BaseLayout>
