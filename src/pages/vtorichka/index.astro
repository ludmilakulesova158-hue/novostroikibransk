---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import Features from '../../components/blocks/Features.astro';
import Steps from '../../components/blocks/Steps.astro';
import Faqs from '../../components/blocks/Faqs.astro';
import CallToAction from '../../components/blocks/CallToAction.astro';
import LeadForm from '../../components/LeadForm.astro';
import Reviews from '../../components/blocks/Reviews.astro';
import { DISTRICTS } from '../../consts';

const features = [
  { icon: 'search', title: 'Подбор вторички', text: 'Найду квартиру в готовом доме под бюджет и район.', href: '/uslugi/podbor-kvartiry/' },
  { icon: 'shield', title: 'Проверка чистоты', text: 'Собственники, обременения, долги и перепланировки.', href: '/uslugi/proverka-obekta/' },
  { icon: 'key', title: 'Сделка «под ключ»', text: 'Договор, безопасные расчёты, регистрация, ключи.', href: '/uslugi/sdelka-pod-klyuch/' },
];

const steps = [
  { title: 'Заявка и бюджет', text: 'Уточняем район, площадь, состояние и бюджет.' },
  { title: 'Подбор и показы', text: 'Отбираю 3–5 квартир и организую показы в удобное время.' },
  { title: 'Проверка объекта', text: 'Проверяю историю права, обременения, долги и перепланировки.' },
  { title: 'Сделка и регистрация', text: 'Готовлю договор, организую расчёты и регистрацию в Росреестре.' },
];

const faq = [
  { q: 'Что проверить при покупке вторички в Брянске?', a: 'Собственников и историю переходов права, обременения и аресты, зарегистрированных лиц (включая детей), долги по ЖКХ и капремонту, перепланировки. Всё это проверяется до внесения задатка.' },
  { q: 'В каких районах Брянска покупать вторичку?', a: 'Советский — ближе к центру и инфраструктуре, Бежицкий — доступнее по цене, Володарский и Фокинский — спокойнее и дешевле. Выбор зависит от работы и образа жизни.' },
  { q: 'Можно ли купить вторичку в ипотеку?', a: 'Да. Подберу банк и программу, помогу с документами и одобрением. По некоторым объектам банк может предъявлять требования к состоянию дома.' },
  { q: 'Как быстро проходит сделка?', a: 'От нескольких дней до двух недель — зависит от готовности документов, способа расчётов и ипотеки.' },
];
---
<BaseLayout
  title="Вторичное жильё в Брянске — купить квартиру"
  description="Купить вторичную квартиру в Брянске: подбор по районам, проверка юридической чистоты, безопасная сделка. Помощь эксперта по недвижимости Ольги Валентиновой."
  path="/vtorichka/"
>
  <Breadcrumbs items={[{ name: 'Вторичное жильё', href: '/vtorichka/' }]} />

  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">Вторичное жильё</p>
      <h1>Вторичка в Брянске: купить безопасно</h1>
      <p class="lead">Готовые квартиры с возможностью заехать сразу. Подберу по районам Брянска, проверю объект и проведу сделку. Ремонт, мебель и инфраструктура — всё видно до покупки.</p>
      <div class="page-hero__actions">
        <a class="btn btn--primary" href="#zayavka">Подобрать квартиру</a>
        <a class="btn btn--ghost" href="#process">Как это работает</a>
      </div>
    </div>
  </section>

  <Features
    eyebrow="Что я сделаю"
    title="Полное сопровождение покупки"
    items={features}
    columns={3}
  />

  <section class="section section--paper2" id="process">
    <div class="container">
      <Steps eyebrow="Процесс" title="Как проходит покупка вторички" items={steps} />
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow prose">
      <h2>Районы Брянска для покупки вторичного жилья</h2>
      <p>{DISTRICTS.join(', ')} — каждый район отличаются ценой, транспортом и инфраструктурой. Советский ближе к центру, Бежицкий предлагает доступные цены, Володарский и Фокинский — более спокойные и бюджетные. Я помогу сопоставить район с вашим сценарием жизни.</p>
      <p>Вторичка выигрывает скоростью: вы видите реальное состояние дома, соседей и подъезд. Главное — правильно проверить объект. Обязательно сравните вторичку с новостройкой: в статье <a href="/blog/vtorichka-ili-novostroyka/">«Вторичка или новостройка в Брянске»</a> разобраны плюсы и минусы.</p>
    </div>
  </section>

  <section class="section">
    <div class="container container--narrow prose">
      <h2>Какие документы проверить при покупке вторички</h2>
      <p>Юридическая чистота вторичного жилья складывается из нескольких уровней проверки. Начните с правоустанавливающих документов и выписки из ЕГРН, затем проверьте основания возникновения права и всю историю переходов. Отдельно проверяются обременения, аресты и зарегистрированные в квартире лица, включая несовершеннолетних.</p>
      <ul>
        <li>Правоустанавливающие документы и выписка из ЕГРН.</li>
        <li>История переходов права и основания владения.</li>
        <li>Обременения, аресты и запреты на регистрацию.</li>
        <li>Согласия супругов и органов опеки, если требуются.</li>
        <li>Долги по коммунальным платежам и взносам на капремонт.</li>
        <li>Перепланировки и соответствие техническому плану.</li>
      </ul>
      <p>Если продавец недавно получил квартиру в наследство или она была в долевой собственности, список проверок расширяется. Такие случаи требуют особого внимания, и я разбираю их до того, как вы внесёте задаток.</p>
    </div>
  </section>

  <Reviews />
  <Faqs items={faq} eyebrow="Вопросы" title="Частые вопросы о вторичке" />
  <LeadForm title="Подберу вторичку под ваш бюджет" source="vtorichka" />
  <CallToAction title='Хотите продать вторичку <span class="hl">выгодно</span>?' text="Оценю по реальным сделкам района, подготовлю к продаже и проведу показы." secondary={{ text: 'Продать недвижимость', href: '/uslugi/prodam-nedvizhimost/' }} />

  <style>
    .page-hero { padding: clamp(24px, 4vw, 48px) 0 clamp(20px, 3vw, 36px); }
    .page-hero h1 { margin-bottom: 16px; }
    .page-hero .lead { max-width: 68ch; }
    .page-hero__actions { display: flex; gap: 12px; flex-wrap: wrap; margin-top: 26px; }
  </style>
</BaseLayout>
