---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import Faqs from '../../../components/blocks/Faqs.astro';
import LeadForm from '../../../components/LeadForm.astro';
import CallToAction from '../../../components/blocks/CallToAction.astro';
import Icon from '../../../components/Icon.astro';
import { articleGraph } from '../../../lib/schema';

const pageUrl = '/novostroyki/obzor/';
const title = 'Новостройки Брянска 2026: застройщики, цены и сроки сдачи';
const description =
  'Обзор новостроек Брянска 2026–2028: застройщики, адреса, сроки сдачи и цены от застройщика. ' +
  'Средняя цена метра 117–128 тыс ₽, квартиры от 2,6 млн ₽. Эконом, бизнес и элит.';
const updated = new Date().toLocaleDateString('ru-RU', { day: 'numeric', month: 'long', year: 'numeric' });

const building = [
  ['Медовый', 'Советский, ул. Ильи Иванова', 'БСК', '4 кв. 2026 — 2 кв. 2028', '1К от 4,2; 2К от 6,4; 3К от 9,9 млн ₽'],
  ['Проспект', 'Советский, Станке Димитрова / Спартаковская', 'СЗ «Созидание»', '4 кв. 2026 / 4 кв. 2028', '2К от 6,3; 3К от 7,7 млн ₽'],
  ['Особин', 'Бежицкий, Бежицкая / Степная', 'Надежда Девелопмент', 'до 4 кв. 2028', 'студии от 3,3; 2К от 5,3; 3К от 7,7 млн ₽'],
  ['О`Берег', 'Бежицкий, Ткачёвых / Николаевой', 'Надежда Девелопмент', '2 кв. 2028', 'студии от 3,4; 3К от 6,4 млн ₽'],
  ['Мегаполис-Парк', 'Брянский р-н, Путёвка', 'СК «Мегаполис»', 'до 3 кв. 2028', '1К от 4,0; 2К от 6,1; 3К от 8,1 млн ₽'],
  ['Дом на Бежицкой', 'Советский', 'СК «Мегаполис»', '4 кв. 2027', '1К от 5,2; 2К от 8,2 млн ₽'],
  ['Цветной бульвар', 'Путёвка, ул. Романа Брянского', 'СЗ «Цветной бульвар»', '2 кв. 2027 / 1 кв. 2028', '1К от 3,2; 2К от 4,9; 3К от 7,5 млн ₽'],
  ['Акватория', 'Бежицкий, ул. Бурова', 'СЗ «Е-ГРУПП»', 'до 2 кв. 2027', '1К от 4,0; 2К от 6,5; 3К от 9,2 млн ₽'],
  ['Изумрудный', 'Московский мкр., 42/3', 'СЗ «Е-ГРУПП»', 'до 4 кв. 2027', '1К от 5,1; 2К от 7,2; 3К от 12,9 млн ₽'],
  ['Архитектор', 'Советский, Амосова', 'СЗ «Фабрика Атмосферы»', 'до 1 кв. 2027', 'от 4,4 млн ₽ (бизнес)'],
  ['Новый город', 'Советский, ул. Войстроченко', 'Ягода Девелопмент', 'до 2 кв. 2028', 'студии от 3,5; 2К от 5,9; 3К от 8,6 млн ₽'],
  ['Д.О.М.', 'Советский, 4-й м-н, Романа Брянского', 'Надежда Девелопмент', '4 кв. 2027', 'студии от 3,5; 2К от 6,8; 3К от 9,8 млн ₽'],
  ['Школьный', 'Советский, ул. Романа Брянского', 'СЗ «Солнечный»', '2026–2027', '1К от 4,8; 2К от 6,5; 3К от 8,0 млн ₽'],
  ['Дуки 46', 'Центр, ул. Дуки', '—', '2 кв. 2027', 'студии от 3,8; 2К от 7,5 млн ₽'],
  ['Гринвуд (клубный квартал)', 'ул. Степная, 20', 'NEXT Девелопмент', 'до 1 кв. 2027', '1К от 7,0; 2К от 8,8 млн ₽ (бизнес)'],
  ['Соборный', 'Соборная ул., 31', 'СЗ ГК «САКС»', 'есть сданные, до 2032', '1К от 4,5 млн ₽'],
  ['Мичуринский (3-я очередь)', 'пос. Мичуринский, Солнечная', '«Комплект»', '3 кв. 2027', '2К от 4,7 млн ₽'],
  ['Градостроительный комплекс', 'Брянский пер.', '—', 'до 3 кв. 2027', '1К от 2,7 млн ₽ (эконом)'],
  ['Дом на Есенина, 2', 'Володарский', 'СЗ «Консоль»', '4 кв. 2026', '10-эт. кирпичный дом'],
  ['Дом на Московском пр.', 'Московский пр.', '«Комплект»', '3 кв. 2026', '—'],
  ['Красной Гвардии', 'Володарский', '—', '2 кв. 2026', 'осталось 2 квартиры'],
];

const done = [
  ['Три башни', 'Бежицкий, ул. Комарова', 'Ягода Девелопмент', 'до 4 кв. 2026', 'студии от 4,5; 2К от 6,7; 3К от 8,8 млн ₽'],
  ['НЕКСТ на Площади Партизан', 'Центр, ул. Крапивницкого', 'NEXT Девелопмент', 'сдан', 'студии от 4,7; 1К от 6,6 млн ₽ (бизнес)'],
  ['Квартал Набережных', 'Бежицкий, Ткачёвых', 'Надежда Девелопмент', 'сдан', '1К от 3,9; 2К от 4,8 млн ₽'],
  ['Д4', 'Бежицкий, ул. Литейная', 'СЗ «БСК»', 'сдан', '3К от 7,8 млн ₽'],
  ['Ютория', 'ул. Степная', 'Надежда Девелопмент', 'сдан 2025', '1К от 5,6 млн ₽'],
  ['Дом у реки', 'ул. Комарова, 47а', 'Ягода Девелопмент', 'сдан', '1К от 4,7 млн ₽'],
  ['Резиденция ГринПарк', 'ул. Визнюка', 'Ягода Девелопмент', 'сдан 2025', '1К от 6,9; 4К от 18,4 млн ₽ (элит)'],
  ['Грей', 'ул. Степная', 'Ягода Девелопмент', 'сдан', '4К от 18,4 млн ₽'],
  ['Атмосфера Джаз', 'ул. Бежицкая, 21Б', '«Атмосфера»', 'сдан 4 кв. 2024', '—'],
  ['Дом на Станке Димитрова, 67/7', 'Советский', 'СК «Мегаполис»', 'сдан 3 кв. 2025', '1К от 5,2 млн ₽'],
  ['Пионер', 'пер. 22 Съезда КПСС, 63а', 'ГК «Регион»', '5 корпусов сдано', '9-эт. кирпич, индивидуальное отопление'],
];

const notes = [
  {
    title: 'ЖК «Проспект» — СЗ «Созидание»',
    text: 'Пр. Станке Димитрова / ул. Спартаковская. Первый дом почти готов (сдача — 4 кв. 2026), второй — 4 кв. 2028. Цены от застройщика: от 4 114 800 ₽ (студии и 1-комнатные от ~97 400 ₽/м²), в продаже есть 2–3-комнатные до 12,5 млн ₽.',
  },
  {
    title: 'ЖК «Архитектор» — «Атмосфера»',
    text: 'Территория бывшего аэропорта, ул. Николая Амосова. Класс «бизнес/элит», дом 2 уже сдан (4 кв. 2025), дом 3 — 1 кв. 2027. Цены от застройщика: от ~4 439 668 ₽ до 16,3 млн ₽, от 142–173 тыс. ₽/м².',
  },
  {
    title: 'ЖК «Три башни» — «Ягода девелопмент»',
    text: 'Ул. Комарова, 39а. Корпуса сданы, остатки до 4 кв. 2026. 1-комн. от 4,5 млн ₽, 2-комн. от 6,7–7,6 млн ₽, 3-комн. от ~11,9 млн ₽; средняя цена — около 124 600 ₽/м².',
  },
  {
    title: 'ЖК «Акватория» — ООО СЗ «Е-ГРУПП»',
    text: 'Ул. Бурова. До 2 кв. 2027. 1-комн. от 4–5,3 млн ₽, 2-комн. от 6,5 млн ₽, 3-комн. ~9,2–9,4 млн ₽; студии уже распроданы. Рядом река Десна и Северный аэропорт.',
  },
  {
    title: 'ЖК «Изумрудный» — «Е-ГРУПП»',
    text: 'Московский микрорайон. Есть сданные корпуса, финал — 4 кв. 2027. 1-комн. от 5,1 млн ₽, 2-комн. от 7,2 млн ₽, 3-комн. от 12,9 млн ₽.',
  },
];

const countryside = {
  title: 'Загородное: КП «Нетьинка КЛАБ»',
  text: 'Закрытый посёлок в 25 км от Брянска, единая архитектура. Сдача — 3 кв. 2028; дома от 7,3 млн ₽ (Смарт М88) до 9,9 млн ₽ (Прайм S133) с участком, есть участки от 130 тыс. ₽.',
};

const faq = [
  { q: 'Сколько стоит квартира в новостройке Брянска?', a: 'Средние ориентиры по рынку: цена метра — 117–128 тыс. ₽, самые доступные квартиры — от 2,6 млн ₽, самые дорогие — до 12–25 млн ₽ в зависимости от класса и района. Цена от застройщика по конкретному ЖК меняется, актуальные цифры уточняйте на консультации.' },
  { q: '«Макромир» — это застройщик?', a: 'Нет. «Макромир» в Брянске — агентство недвижимости (офис на ул. Дуки, 63), партнёр местных застройщиков. Рендеры и цены у агентства те же, что и напрямую у застройщиков; агентство помогает подобрать ЖК, проверить объект и провести сделку.' },
  { q: 'Какие новостройки Брянска сдаются в 2026–2028?', a: 'В обзоре — более 20 строящихся ЖК со сдачей в 2026–2028: Медовый, Проспект, Особин, О`Берег, Мегаполис-Парк, Цветной бульвар, Акватория, Изумрудный, Архитектор, Новый город, Д.О.М., Школьный, Дуки 46, Гринвуд, Соборный и другие.' },
  { q: 'Где в Брянске самый большой выбор новостроек?', a: 'Самый масштабный выбор — на стыке Советского района и Путёвки (Новый город, Цветной бульвар, Мегаполис-Парк) и в Бежицком районе (Ткачёвых, Флотская, Комарова).' },
  { q: 'Есть ли проблемные новостройки в Брянске?', a: 'Да, встречаются заморозки. Например, ЖК «Мичуринский» от ГК «СтройГарант»: дома есть сданные, но один корпус стоит с 2020 года и сроки переносятся. Одноимённый комплекс от «Комплекта» строится нормально. Поэтому перед покупкой всегда проверяем застройщика и проектную декларацию.' },
  { q: 'Какая новостройка в Брянске самая доступная?', a: 'Эконом-сегмент (от 2,6–3,5 млн ₽) — «Градостроительный комплекс», «Мичуринский», а также студии в «Д.О.М.» и «Особин». Бизнес-класс — «Архитектор», «НЕКСТ», «Гринвуд», «Новый город», «Мегаполис-Парк»; элитный — «Резиденция ГринПарк».' },
];

const sources = [
  { label: 'Домклик Брянск', href: 'https://bryansk.domclick.ru' },
  { label: 'Яндекс Недвижимость', href: 'https://realty.yandex.ru' },
  { label: 'm2.ru', href: 'https://www.m2.ru' },
  { label: 'Avito Недвижимость', href: 'https://www.avito.ru' },
  { label: 'Этажи Брянск', href: 'https://bryansk.etagi.com' },
  { label: 'Макромир Брянск (ВК)', href: 'https://vk.ru/id180315617' },
];

const schema = articleGraph({
  title,
  description,
  url: pageUrl,
  datePublished: new Date('2026-02-01'),
  dateModified: new Date(),
  keyword: 'новостройки Брянска 2026, цены, сроки сдачи, застройщики, ЖК Брянск',
  section: 'Новостройки',
});
---
<BaseLayout title={title} description={description} path={pageUrl} schema={schema} ogType="article">
  <Breadcrumbs items={[{ name: 'Новостройки Брянска', href: '/novostroyki/' }, { name: 'Обзор цен и сроков', href: pageUrl }]} withSchema={false} />

  <article class="review">
    <div class="container container--narrow">
      <p class="eyebrow">Обзор рынка · обновлено {updated}</p>
      <h1>{title}</h1>

      <p class="review__lead">
        В Брянске сейчас <strong>20–30 активных жилых комплексов</strong>. Средний ориентир по рынку —
        <strong>117–128 тыс. ₽ за м²</strong>, самые доступные квартиры — от <strong>2,6 млн ₽</strong>,
        самые дорогие — до <strong>12–25 млн ₽</strong> в зависимости от класса и района. Ниже — сводка
        по всем проектам: застройщик, адрес, срок сдачи и цены от застройщика.
      </p>

      <p class="small muted">
        «Макромир» в Брянске — это агентство недвижимости (офис на ул. Дуки, 63), партнёр местных
        застройщиков, а не застройщик. Рендеры и цены у агентства те же, что и напрямую у застройщиков.
      </p>

      <h2 id="stroyashchie">Строящиеся — сдача 2026–2028</h2>
      <div class="table-wrap">
        <table class="zhk-table">
          <thead>
            <tr><th>ЖК</th><th>Адрес / район</th><th>Застройщик</th><th>Сдача</th><th>Цены от застройщика</th></tr>
          </thead>
          <tbody>
            {building.map((r) => (
              <tr>
                <td class="zhk-table__name">{r[0]}</td>
                <td>{r[1]}</td>
                <td>{r[2]}</td>
                <td>{r[3]}</td>
                <td>{r[4]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="sdany">Сданы или почти сданы (остатки, без строительства)</h2>
      <div class="table-wrap">
        <table class="zhk-table">
          <thead>
            <tr><th>ЖК</th><th>Район</th><th>Застройщик</th><th>Сдача</th><th>Цены</th></tr>
          </thead>
          <tbody>
            {done.map((r) => (
              <tr>
                <td class="zhk-table__name">{r[0]}</td>
                <td>{r[1]}</td>
                <td>{r[2]}</td>
                <td>{r[3]}</td>
                <td>{r[4]}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <h2 id="podrobnee">Подробнее по отдельным ЖК</h2>
      <div class="notes">
        {notes.map((n) => (
          <div class="note">
            <h3>{n.title}</h3>
            <p>{n.text}</p>
          </div>
        ))}
        <div class="note">
          <h3>{countryside.title}</h3>
          <p>{countryside.text}</p>
        </div>
      </div>

      <h2 id="vnimanie">На что обратить внимание</h2>
      <ul class="review__list">
        <li>
          <strong>Замороженный проект.</strong> ЖК «Мичуринский» от ГК «СтройГарант» — дома есть сданные,
          но один корпус стоит с 2020 года, сроки переносятся из года в год. Одноимённый комплекс от
          «Комплекта» строится нормально, 3-я очередь — 3 кв. 2027.
        </li>
        <li>
          <strong>Самый масштабный выбор</strong> сейчас — на стыке Советского района и Путёвки
          (Новый город, Цветной бульвар, Мегаполис-Парк) и в Бежицком районе (Ткачёвых, Флотская, Комарова).
        </li>
        <li>
          <strong>Эконом-сегмент</strong> (от 2,6–3,5 млн ₽) — Градостроительный комплекс, Мичуринский,
          студии в «Д.О.М.» и «Особин».
        </li>
        <li>
          <strong>Бизнес-класс</strong> — Архитектор, НЕКСТ, Гринвуд, Новый город, Мегаполис-Парк;
          <strong>элитный</strong> — ГринПарк.
        </li>
      </ul>

      <p class="small muted">
        Источники: данные агрегаторов и площадок —
        {sources.map((s, i) => (
          <>{i > 0 ? ', ' : ''}<a href={s.href} target="_blank" rel="nofollow noopener">{s.label}</a></>
        ))}.
        Цены и сроки меняются — уточняйте их на дату покупки.
      </p>
    </div>
  </article>

  <Faqs items={faq} eyebrow="Вопросы" title="Частые вопросы о новостройках Брянска" />

  <section class="section section--tight">
    <div class="container container--narrow prose">
      <h2>Как выбрать новостройку в Брянске</h2>
      <p>Начните с района и бюджета, а не с картинки ЖК. Советский район и Путёвка — самый большой выбор новостроек, Бежицкий — развитая инфраструктура и доступные цены. Определите срок заселения: готовые дома позволяют заехать сразу, строящиеся — дешевле на старте и требуют ожидания и отделки.</p>
      <p>Перед сделкой проверьте застройщика, проектную декларацию и схему продаж по 214-ФЗ, наличие эскроу-счёта. Помогу сопоставить варианты по цене за метр, срокам и ликвидности, а также подобрать ипотеку. Полный список ЖК — в разделе <a href="/novostroyki/">Новостройки Брянска</a>.</p>
    </div>
  </section>

  <LeadForm title="Подберу новостройку под ваш бюджет" text="Оставьте контакты — сопоставлю ЖК по цене, сроку и району, подберу варианты и помогу с ипотекой. Консультация бесплатная." source="obzor" />
  <CallToAction title='Нужен взгляд на рынок <span class="hl">вживую</span>?' text="Позвоните или оставьте заявку — разберу вашу ситуацию и предложу конкретные ЖК." secondary={{ text: 'Все новостройки', href: '/novostroyki/' }} />

  <style>
    .review { padding: clamp(20px, 3vw, 40px) 0 clamp(10px, 2vw, 20px); }
    .review h1 { margin-bottom: 18px; }
    .review__lead { font-size: clamp(17px, 2.1vw, 20px); color: var(--ink-2); line-height: 1.6; }
    .review h2 { margin-top: 1.7em; }
    .review__list { display: grid; gap: 12px; padding-left: 1.2em; }
    .review__list li { color: var(--ink-2); }
    .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r); background: var(--surface); margin: 18px 0 8px; }
    .zhk-table { width: 100%; border-collapse: collapse; font-size: 14.5px; min-width: 720px; }
    .zhk-table th { text-align: left; padding: 12px 14px; background: var(--paper-2); color: var(--ink); font-weight: 700; font-size: 12.5px; text-transform: uppercase; letter-spacing: .04em; border-bottom: 1px solid var(--line); white-space: nowrap; }
    .zhk-table td { padding: 12px 14px; border-bottom: 1px solid var(--line); color: var(--ink-2); vertical-align: top; }
    .zhk-table tr:last-child td { border-bottom: 0; }
    .zhk-table__name { font-weight: 700; color: var(--ink); white-space: nowrap; }
    .notes { display: grid; gap: 14px; margin-top: 16px; }
    .note { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); padding: 18px 22px; }
    .note h3 { margin: 0 0 8px; font-size: 19px; }
    .note p { margin: 0; color: var(--ink-2); font-size: 15.5px; }
  </style>
</BaseLayout>
