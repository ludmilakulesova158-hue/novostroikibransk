---
// Cookie-баннер + гейтинг Яндекс.Метрики (152-ФЗ): счётчик грузится ТОЛЬКО после согласия.
// Если PUBLIC_METRIKA_ID не задан — баннер не показываем (аналитики нет).
import { SITE } from '../consts';
const mid = SITE.metrikaId;
const policy = SITE.policyPath;
---
{mid && (
  <>
    <script is:inline set:html={`
      window.__ymLoad=function(){if(window.__ymLoaded)return;window.__ymLoaded=true;
      (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
      m[i].l=1*new Date();for(var j=0;j<e.scripts.length;j++){if(e.scripts[j].src===r){return;}}
      k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
      (window,document,"script","https://mc.yandex.ru/metrika/tag.js","ym");
      ym(${mid},"init",{clickmap:true,trackLinks:true,accurateTrackBounce:true,webvisor:true});};
      try{if(localStorage.getItem("cookie-consent")==="accepted")window.__ymLoad();}catch(e){}
    `} />

    <div id="cookie-banner" class="cookie-banner" hidden>
      <p class="cookie-banner__text">
        Мы используем cookie и Яндекс.Метрику для работы сайта и статистики. Продолжая, вы соглашаетесь с
        <a href={policy}>политикой обработки персональных данных</a>.
      </p>
      <div class="cookie-banner__actions">
        <button type="button" class="btn btn--primary btn--sm" onclick="cookieChoice('accepted')">Принять</button>
        <button type="button" class="btn btn--ghost btn--sm" onclick="cookieChoice('declined')">Отклонить</button>
      </div>
    </div>

    <script is:inline>{`
      function cookieChoice(v){try{localStorage.setItem('cookie-consent',v)}catch(e){}var el=document.getElementById('cookie-banner');if(el)el.hidden=true;if(v==='accepted'&&window.__ymLoad)window.__ymLoad();}
      (function(){var c;try{c=localStorage.getItem('cookie-consent')}catch(e){}if(!c){var el=document.getElementById('cookie-banner');if(el)el.hidden=false;}})();
    `}</script>
  </>
)}

<style>
  .cookie-banner {
    position: fixed; left: 16px; right: 16px; bottom: 16px; z-index: 9999; max-width: 560px;
    background: var(--surface); border: 1px solid var(--line); border-radius: var(--r); box-shadow: var(--shadow-lg);
    padding: 18px 20px; font-size: 14px; line-height: 1.5; color: var(--ink-2);
  }
  .cookie-banner__text { margin: 0 0 12px; }
  .cookie-banner__text a { color: var(--terracotta); text-decoration: underline; text-underline-offset: 3px; }
  .cookie-banner__actions { display: flex; gap: 10px; flex-wrap: wrap; }
  @media (min-width: 700px) { .cookie-banner { left: auto; } }
</style>
